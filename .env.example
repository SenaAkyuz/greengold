# Copy to .env.local and fill in. Never commit .env.local.

# Public (safe to expose; needed on Vercel Production + Preview)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional read token (published dataset is public, so the site reads without one;
# add on Vercel only if you later make the dataset private or add draft preview)
SANITY_API_READ_TOKEN=

# Write token — LOCAL ONLY, for the one-off Faz 5 migration. DO NOT add to Vercel.
SANITY_API_WRITE_TOKEN=

# Webhook signature secret — set the SAME value on Vercel (server-only) and in the
# Sanity webhook config. Used by /api/revalidate to verify Sanity calls.
SANITY_REVALIDATE_SECRET=
